{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        ".claude/hooks/lib/responsive-check.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          },
          "complexity": {
            "useOptionalChain": "off"
          }
        }
      }
    },
    {
      "includes": [
        ".claude/hooks/lib/screenshot.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          },
          "complexity": {
            "useOptionalChain": "off"
          }
        }
      }
    },
    {
      "includes": [
        "preview/attio-mobile.html"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off",
            "useExponentiationOperator": "off",
            "noDescendingSpecificity": "off"
          },
          "complexity": {
            "noImportantStyles": "off",
            "useOptionalChain": "off"
          },
          "a11y": {
            "useValidAnchor": "off",
            "useAriaPropsSupportedByRole": "off",
            "noNoninteractiveTabindex": "off"
          },
          "suspicious": {
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "preview/host-demo.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": [
        "preview/index.html"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": [
        "preview/serve.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tooling/build-index.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tooling/capture-architecture.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          },
          "complexity": {
            "noCommaOperator": "off",
            "useOptionalChain": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tooling/capture-motion.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off"
          },
          "complexity": {
            "useOptionalChain": "off",
            "noCommaOperator": "off"
          },
          "suspicious": {
            "noGlobalIsNan": "off",
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tooling/capture.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
