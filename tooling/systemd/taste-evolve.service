[Unit]
Description=Web Design Taste - weekly self-evolving corpus run (harvest -> distill -> PR -> report)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Adjust if the repo lives elsewhere. Runs as your user so `claude -p` uses your subscription.
WorkingDirectory=/projects/taste
ExecStart=/projects/taste/tooling/evolve.sh
# Optional secrets (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, CLAUDE_BIN). `-` = ok if absent.
EnvironmentFile=-%h/.config/taste/evolve.env
TimeoutStartSec=3600
