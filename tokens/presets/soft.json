{
  "$description": "Direction preset: soft. PARTIAL override of tokens.json — larger radii, soft diffused shadows, gentler warm colors, rounded display stack, springy motion. Only keys that differ from the house base.",
  "color": {
    "bg":        { "$value": "#fdfbf7", "$type": "color" },
    "surface":   { "$value": "#f6f3ee", "$type": "color" },
    "surface-2": { "$value": "#efeae2", "$type": "color" },
    "fg":        { "$value": "#26231f", "$type": "color" },
    "muted":     { "$value": "#6e6a64", "$type": "color" },
    "subtle":    { "$value": "#9d978e", "$type": "color" },
    "border":    { "$value": "#ece7df", "$type": "color" },
    "accent":    { "$value": "#5b8def", "$type": "color" },
    "accent-fg": { "$value": "#ffffff", "$type": "color" },
    "success":   { "$value": "#3fae72", "$type": "color" },
    "warning":   { "$value": "#d99441", "$type": "color" },
    "danger":    { "$value": "#e26a6a", "$type": "color" },
    "focus":     { "$value": "#5b8def", "$type": "color" }
  },
  "font": {
    "sans": { "$value": "'Plus Jakarta Sans', 'Geist Sans', system-ui, sans-serif", "$type": "fontFamily" },
    "display": { "$value": "'Bricolage Grotesque', 'Plus Jakarta Sans', 'SF Pro Rounded', system-ui, sans-serif", "$type": "fontFamily" },
    "mono": { "$value": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" }
  },
  "leading": {
    "tight":   { "$value": "1.15", "$type": "number" },
