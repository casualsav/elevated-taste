    "xl":   { "$value": "28px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "sm": { "$value": "0 2px 8px rgba(38,35,31,0.05)", "$type": "shadow" },
    "md": { "$value": "0 10px 30px rgba(38,35,31,0.08)", "$type": "shadow" },
    "lg": { "$value": "0 24px 60px rgba(38,35,31,0.12)", "$type": "shadow" }
  },
  "duration": {
    "base": { "$value": "300ms", "$type": "duration" },
    "slow": { "$value": "700ms", "$type": "duration" }
  },
  "ease": {
    "standard": { "$value": "cubic-bezier(0.32, 0.72, 0, 1)", "$type": "cubicBezier" },
    "entrance": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" }
  }
