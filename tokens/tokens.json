{
  "$description": "House design tokens — framework-agnostic source of truth. Built to tokens.css by build.mjs. SEED values (Checkpoint 1); finalized during synthesis (Checkpoint 5). Direction presets in presets/ override these.",
  "color": {
    "bg":        { "$value": "#ffffff", "$type": "color" },
    "surface":   { "$value": "#f7f8fa", "$type": "color" },
    "surface-2": { "$value": "#eef0f3", "$type": "color" },
    "fg":        { "$value": "#0b0d12", "$type": "color" },
    "muted":     { "$value": "#5b6472", "$type": "color" },
    "subtle":    { "$value": "#8b94a3", "$type": "color" },
    "border":    { "$value": "#e3e6eb", "$type": "color" },
    "accent":    { "$value": "#2f6df6", "$type": "color" },
    "accent-fg": { "$value": "#ffffff", "$type": "color" },
    "success":   { "$value": "#1f9d57", "$type": "color" },
    "warning":   { "$value": "#c97a0a", "$type": "color" },
    "danger":    { "$value": "#d23f3f", "$type": "color" },
    "focus":     { "$value": "#2f6df6", "$type": "color" },
    "surface-inverse": { "$value": "#0b0d12", "$type": "color" },
    "fg-inverse":      { "$value": "#ffffff", "$type": "color" },
    "border-inverse":  { "$value": "rgba(255,255,255,0.16)", "$type": "color" },

    "bg-dark":        { "$value": "#0b0d12", "$type": "color", "$description": "dark-band page ground (dark sections on a light page)" },
    "surface-dark":   { "$value": "#151922", "$type": "color", "$description": "card/tile surface on bg-dark" },
    "surface-dark-2": { "$value": "#1e242f", "$type": "color", "$description": "nested surface on surface-dark" },
    "fg-on-dark":     { "$value": "#f5f7fa", "$type": "color", "$description": "primary text on dark grounds (off-white, not pure)" },
    "muted-on-dark":  { "$value": "rgba(245,247,250,0.64)", "$type": "color", "$description": "secondary text on dark grounds" },
    "border-on-dark": { "$value": "rgba(255,255,255,0.14)", "$type": "color", "$description": "hairline borders on dark grounds" },
    "border-strong":  { "$value": "#c9cfd8", "$type": "color", "$description": "emphasized border (inputs, active outlines)" },
    "hairline":       { "$value": "rgba(11,13,18,0.08)", "$type": "color", "$description": "faintest rule/divider on light grounds" }
  },
  "font": {
    "sans": { "$value": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif", "$type": "fontFamily" },
    "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace", "$type": "fontFamily" }
  },
  "text": {
    "xs":      { "$value": "0.75rem",  "$type": "dimension" },
    "sm":      { "$value": "0.875rem", "$type": "dimension" },
    "base":    { "$value": "1rem",     "$type": "dimension" },
    "md":      { "$value": "1.125rem", "$type": "dimension" },
    "lg":      { "$value": "1.25rem",  "$type": "dimension" },
    "xl":      { "$value": "1.5rem",   "$type": "dimension" },
    "2xl":     { "$value": "1.875rem", "$type": "dimension" },
    "3xl":     { "$value": "2.25rem",  "$type": "dimension" },
    "4xl":     { "$value": "3rem",     "$type": "dimension" },
    "5xl":     { "$value": "3.75rem",  "$type": "dimension" },
    "display": { "$value": "4.5rem",   "$type": "dimension" }
  },
  "weight": {
    "regular":  { "$value": "400", "$type": "fontWeight" },
    "medium":   { "$value": "500", "$type": "fontWeight" },
    "semibold": { "$value": "600", "$type": "fontWeight" },
    "bold":     { "$value": "700", "$type": "fontWeight" }
  },
  "leading": {
    "tight":   { "$value": "1.1",  "$type": "number" },
    "snug":    { "$value": "1.25", "$type": "number" },
    "normal":  { "$value": "1.5",  "$type": "number" },
    "relaxed": { "$value": "1.7",  "$type": "number" }
  },
  "tracking": {
    "tight":  { "$value": "-0.02em", "$type": "dimension" },
    "normal": { "$value": "0em",     "$type": "dimension" },
    "wide":   { "$value": "0.04em",  "$type": "dimension" },
    "display": { "$value": "-0.022em", "$type": "dimension", "$description": "size-proportional ramp — bigger type, tighter tracking (Linear's measured display end)" },
    "heading": { "$value": "-0.015em", "$type": "dimension", "$description": "size-proportional ramp — headings sit between display and UI" },
    "ui":      { "$value": "-0.011em", "$type": "dimension", "$description": "size-proportional ramp — UI/label sizes (Linear's measured UI end)" },
    "body":    { "$value": "0",        "$type": "dimension", "$description": "size-proportional ramp — body text stays neutral" },
    "caps":    { "$value": "0.06em",   "$type": "dimension", "$description": "small all-caps opens up; the ramp inverts below body size" }
  },
  "space": {
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "5":  { "$value": "1.5rem",  "$type": "dimension" },
    "6":  { "$value": "2rem",    "$type": "dimension" },
    "7":  { "$value": "3rem",    "$type": "dimension" },
    "8":  { "$value": "4rem",    "$type": "dimension" },
    "9":  { "$value": "6rem",    "$type": "dimension" },
    "10": { "$value": "8rem",    "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "md":   { "$value": "8px",    "$type": "dimension" },
    "lg":   { "$value": "12px",   "$type": "dimension" },
    "xl":   { "$value": "16px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 2px rgba(11,13,18,0.06)", "$type": "shadow" },
    "md": { "$value": "0 4px 12px rgba(11,13,18,0.08)", "$type": "shadow" },
    "lg": { "$value": "0 12px 32px rgba(11,13,18,0.12)", "$type": "shadow" }
  },
  "duration": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "base": { "$value": "200ms", "$type": "duration" },
    "slow": { "$value": "320ms", "$type": "duration" }
  },
  "ease": {
    "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
    "entrance": { "$value": "cubic-bezier(0, 0, 0, 1)",   "$type": "cubicBezier" },
    "exit":     { "$value": "cubic-bezier(0.3, 0, 1, 1)", "$type": "cubicBezier" }
  },
  "container": {
    "content": { "$value": "720px",  "$type": "dimension" },
    "sm":      { "$value": "640px",  "$type": "dimension" },
    "md":      { "$value": "768px",  "$type": "dimension" },
    "lg":      { "$value": "1024px", "$type": "dimension" },
    "xl":      { "$value": "1280px", "$type": "dimension" }
  }
}
