{
  "color": {
    "bg": "#f5f6f8",
    "surface": "#ffffff",
    "surface-2": "#f5f6f8",
    "fg": "#353a44",
    "muted": "#596171",
    "subtle": "#697386",
    "accent": "#675dff",
    "roles": {
      "ink-dark": "#1a1f36",
      "icon": "#8792a2",
      "link-blue": "#0072e9",
      "select-violet": "#9966ff",
      "border-hairline": "#d8dee4",
      "surface-nested": "#f5f6f8",
      "error": "#df1b41",
      "canvas-texture": "dot-grid.png tiled on #f5f6f8"
    }
  },
  "type": {
    "families": ["Inter", "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto"],
    "scale": ["0.75rem", "0.875rem", "1rem", "1.125rem", "1.5rem"],
    "weights": [400, 500, 600, 700],
    "leading": [1.1, 1.33, 1.5]
  },
  "space": { "base": "4px", "scale": ["4px", "6px", "8px", "12px", "16px", "24px", "40px", "48px"] },
  "radius": ["6px", "8px", "10px", "12px", "24px", "40px", "100px"],
  "shadow": [
    "0 2px 5px rgba(60,66,87,.12), 0 1px 1px rgba(0,0,0,.08)",
    "0 3px 6px rgba(0,0,0,.12), 0 7px 14px rgba(48,49,61,.08)",
    "0 0 0 1px rgba(136,152,170,.1), 0 15px 35px rgba(129,129,136,.1), 0 5px 15px rgba(0,0,0,.08)",
    "0 40px 100px rgba(0,0,0,.2), 0 6px 12px rgba(0,0,0,.03)"
  ],
  "motion": {
    "durations": ["100ms", "120ms", "150ms", "200ms", "250ms", "450ms"],
    "easings": ["linear", "ease-in-out", "cubic-bezier(0.18,1,0.4,1)", "cubic-bezier(0.19,1,0.22,1)"],
    "triggers": ["hover", "load", "in-view"],
    "techniques": ["layered-shadow-hover-lift", "additive-selection-ring", "modal-scale-fade", "panel-slide-in", "button-micro-scale"],
    "scroll_effects": [],
    "stack": ["CSS @keyframes", "CSS transitions", "React (Next.js)"],
    "reduced_motion": "not-respected"
  },
  "notes": "Colors from :root custom properties + computed-style profile. bg set to #f5f6f8 (dot-grid texture tiles over it) since body background is an image, not a flat color. Type scale collapsed to the 5 real sizes (12/14/16/18/24px). Shadow list is the four distinct composed elevations (button/small, medium, popover-ring, modal). craft.theme.dark values are degenerate (bg transparent, fg #000, accent #fff) — the site does not genuinely re-theme dark, so color.dark is omitted. Two @keyframes only (slideInFromLeft/Right); modal transition uses the cubic-bezier curve, not a keyframe."
}
