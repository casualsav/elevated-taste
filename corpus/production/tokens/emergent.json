{
  "color": {
    "bg": "#ffffff",
    "surface": "#f5f4f2",
    "surface-2": "#ebebeb",
    "fg": "#0e0e0e",
    "muted": "#666666",
    "border": "#e5e3e1",
    "accent": "#0051ff",
    "roles": {
      "gradient-from": "#4e9bee",
      "gradient-mid": "#57d5fe",
      "gradient-to": "#3489fe",
      "accent-green": "#7fff8b",
      "accent-cyan": "#80ffff",
      "yc-orange": "#e57845",
      "card-dark": "rgba(0,0,0,0.9)"
    },
    "dark": {
      "bg": "#111111",
      "surface": "#18181b",
      "fg": "#ffffff",
      "muted": "rgba(255,255,255,0.5)",
      "accent": "#0051ff"
    }
  },
  "type": {
    "families": ["Brockmann", "Inter", "Ndot"],
    "scale": ["0.75rem", "0.875rem", "1rem", "1.375rem", "1.5rem", "2rem", "2.25rem", "4.5rem"],
    "weights": [400, 500, 600, 700],
    "leading": [1.0, 1.1, 1.5]
  },
  "space": { "base": "8px", "scale": ["4px", "8px", "12px", "16px", "24px", "32px", "48px", "64px", "80px", "150px", "200px"] },
  "radius": ["4px", "12px", "20px", "28px", "9999px"],
  "shadow": [
    "0 1px 2px rgba(0,0,0,0.05)",
    "0 25px 50px -12px rgba(0,0,0,0.25)"
  ],
  "motion": {
    "durations": ["150ms", "200ms", "300ms"],
    "easings": ["cubic-bezier(0.4, 0, 0.2, 1)", "cubic-bezier(0, 0, 0.2, 1)"],
    "triggers": ["scroll-progress", "in-view", "hover", "load"],
    "techniques": ["pinned-header", "sticky-cta-reveal", "infinite-marquee", "skeleton-shimmer", "fill-progress", "hover-lift"],
    "scroll_effects": [
      { "name": "pinned-header", "property": "position", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "sticky-cta-reveal", "property": "opacity", "trigger": "in-view", "safety": "production-safe" },
      { "name": "sticky-cta-rise", "property": "transform", "trigger": "in-view", "safety": "production-safe" },
      { "name": "app-marquee", "property": "transform", "trigger": "load", "safety": "production-safe" },
      { "name": "skeleton-shimmer", "property": "background", "trigger": "load", "safety": "production-safe" },
      { "name": "fill-progress", "property": "clip", "trigger": "load", "safety": "spectacle-only" }
    ],
    "stack": ["IntersectionObserver", "CSS @keyframes", "requestAnimationFrame"],
    "reduced_motion": "respected"
  },
  "notes": "Colors: hairline #e5e3e1 (rgb 229,227,225) is the single dominant border, used 630x; fg #0e0e0e and muted #666 from computed styles; accent #0051ff appears in computed styles though the CSS token is --accent-blue: hsl(220 100% 54%). Gradient hex from the --auth-gradient token (90deg #4e9bee → #57d5fe 58.5% → #3489fe). accent-green/cyan approximated from HSL tokens (132/180 100% 75%). Radius 20px = the shadcn --radius:1.25rem; 9999px pills dominate buttons/toggles. Type scale collapsed from computed sizes (72/36/32/22/16/14/12px); Ndot is a single-weight display/novelty accent, not a body face. fill-progress animates width (layout) so tagged spectacle-only. Dark palette from craft.theme.dark (site supports prefers-color-scheme dark)."
}
