    }
  },
  "type": {
    "families": ["MartinaPlantijn, Georgia, serif", "LTSuperior, system-ui, sans-serif", "Geist, sans-serif", "ui-monospace, SFMono-Regular, Menlo, monospace"],
    "scale": ["0.75rem", "0.875rem", "1rem", "1.125rem", "1.5rem", "1.75rem", "clamp(42px, 4.8vw, 68px)"],
    "weights": [400, 500, 700],
