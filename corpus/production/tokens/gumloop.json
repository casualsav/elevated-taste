{
  "color": {
    "bg": "#ffffff",
    "surface": "#f4f5f8",
    "fg": "#14161a",
    "muted": "#878a94",
    "accent": "#0190ff",
    "roles": {
      "border": "#e9eaef",
      "hairline": "#eceef2",
      "ink": "#14161a",
      "neutral-muted": "#878a94",
      "channel-active-bg": "#eff0f4",
      "dark-band-bg": "#14161a",
      "accent-blue": "#0190ff",
      "accent-indigo": "#5b5fc7",
      "accent-pink": "#f6339a",
      "accent-amber": "#ffad0a",
      "accent-green": "#16a34a"
    }
  },
  "type": {
    "families": ["GeistSans", "GeistMono", "Gellix", "Caveat"],
    "scale": ["0.75rem", "0.875rem", "1rem", "1.125rem", "1.5rem", "2.25rem", "3rem"],
    "weights": [400, 500, 600],
    "leading": [1.0, 1.25, 1.5],
    "tracking_ramp": {
      "48px": "-1.2px",
      "36px": "-0.9px",
      "18px": "-0.45px",
      "12px": "-0.3px"
    },
    "features": ["tabular-nums"],
    "fluid": true
  },
  "space": {
    "base": "8px",
    "scale": ["4px", "6px", "8px", "12px", "16px", "24px", "32px", "64px", "80px", "128px"]
  },
  "radius": ["2px", "6px", "8px", "10px", "18px", "9999px"],
  "shadow": [
    "0 0px 0px 1px rgba(224,226,232,1), 0 1px 1px -0.5px rgba(0,0,0,0.02), 0 3px 3px -1.5px rgba(0,0,0,0.02), 0 6px 6px -3px rgba(0,0,0,0.01)",
    "0 1px 1px -0.5px rgba(0,0,0,0.06), 0 3px 3px -1.5px rgba(0,0,0,0.06)"
  ],
  "motion": {
    "durations": ["150ms", "200ms", "300ms", "500ms", "1000ms", "3600ms"],
    "easings": [
      "cubic-bezier(0, 0, 0.2, 1)",
      "cubic-bezier(0.4, 0, 0.2, 1)",
      "cubic-bezier(0.625, 0.05, 0, 1)",
      "cubic-bezier(0.77, 0, 0.175, 1)",
      "cubic-bezier(0.34, 1.56, 0.64, 1)"
    ],
    "triggers": ["in-view", "scroll-progress", "hover", "load"],
    "techniques": [
      "sticky-pin-scrollytelling",
      "in-view-sequential-highlight",
      "in-view-fade-rise",
      "ambient-loop-diagram",
      "scroll-progress-sweep",
      "cursor-follower"
    ],
    "scroll_effects": [
      { "name": "channel-row-highlight", "property": "background", "trigger": "in-view", "safety": "production-safe" },
      { "name": "channel-row-ink", "property": "color", "trigger": "in-view", "safety": "production-safe" },
      { "name": "card-fade-rise", "property": "transform", "trigger": "in-view", "safety": "production-safe" },
      { "name": "shimmer-sweep", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "accent-icon-rotate", "property": "transform", "trigger": "scroll-progress", "safety": "spectacle-only" },
      { "name": "cursor-follower", "property": "transform", "trigger": "hover", "safety": "spectacle-only" }
    ],
    "stack": ["IntersectionObserver", "CSS @keyframes", "requestAnimationFrame", "CSS transitions"],
    "reduced_motion": "respected"
  },
  "notes": "Light page only; craft.theme.dark is a mis-sampled probe of the single dark #control band, so no color.dark is emitted — the site does not re-theme. Colors converted from lab/oklab to approximate hex. fg/ink lab(8.7)~#14161a; muted = --brand-neutral-muted lab(59)~#878a94; border = single repeated hairline lab(93.3)~#e9eaef; channel-active-bg = lab(95.9)~#eff0f4. The accent set is a wide saturated palette reserved for product-demo UI/chips/charts — only a few representative hues sampled here; chrome uses blue #0190ff. Weight ladder normalized to 400/500/600 (600 nearly unused)."
}
