{
  "color": {
    "bg": "#F7F7F4",
    "surface": "#F2F1ED",
    "surface-2": "#E6E5E0",
    "fg": "#26251E",
    "muted": "rgba(38,37,30,0.6)",
    "accent": "#DB704B",
    "border": "rgba(38,37,30,0.1)",
    "roles": {
      "page": "#F7F7F4",
      "panel": "#F2F1ED",
      "panel-deep": "#E6E5E0",
      "ink": "#26251E",
      "ink-muted": "rgba(38,37,30,0.6)",
      "ink-faint": "rgba(38,37,30,0.4)",
      "link": "#DB704B",
      "btn-primary-bg": "#26251E",
      "btn-primary-hover": "#3B3A33",
      "code-syntax": {
        "keyword": "#B3003F",
        "type": "#6049B3",
        "string": "#427986",
        "fn": "#AA52A2",
        "accent": "#9E94D5",
        "amber": "#C08532"
      }
    },
    "dark": { "bg": "#14120B", "fg": "#EDECEC", "accent": "#EDECEC" }
  },
  "type": {
    "families": ["CursorGothic", "system-ui", "EB Garamond", "ui-monospace"],
    "scale": ["0.6875rem", "0.75rem", "0.8125rem", "0.875rem", "1rem", "1.375rem", "1.625rem", "2.25rem", "4.5rem"],
    "weights": [400, 500, 600],
    "leading": [1.1, 1.3, 1.5],
    "tracking": { "display-72": "-0.03em", "h-36": "-0.02em", "h-26": "-0.0125em", "body-16": "0.005em", "label-14": "0.01em" }
  },
  "space": { "base": "4px", "scale": ["4px", "8px", "12px", "16px", "20px", "28px", "48px", "67px"] },
  "radius": ["2px", "4px", "8px", "10px", "9999px"],
  "shadow": [
    "0 0 0 1px rgba(38,37,30,0.1)",
    "0 18px 36px -18px rgba(0,0,0,0.28), 0 0 0 1px rgba(38,37,30,0.1)",
    "0 28px 70px rgba(0,0,0,0.14), 0 14px 32px rgba(0,0,0,0.1), 0 0 0 1px rgba(38,37,30,0.1)"
  ],
  "motion": {
    "durations": ["140ms", "150ms", "200ms", "500ms", "2500ms"],
    "easings": ["cubic-bezier(0.4,0,0.2,1)", "cubic-bezier(0.25,1,0.5,1)", "cubic-bezier(0,0,0.2,1)"],
    "triggers": ["scroll-progress", "in-view", "hover", "load"],
    "techniques": ["pinned-header", "in-view-fade-rise", "live-embedded-product-demo", "quiet-hover-feedback"],
    "scroll_effects": [
      { "name": "pinned-header", "property": "position", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "in-view-fade-rise", "property": "transform|opacity", "trigger": "in-view", "safety": "production-safe" },
      { "name": "background-shift", "property": "background", "trigger": "in-view", "safety": "production-safe" }
    ],
    "stagger_delays_ms": [40, 80, 120],
    "io_thresholds": [[0.15, 0.35], [0, 0.99], [0, 0.3, 0.5, 0.66, 0.9, 1]],
    "stack": ["IntersectionObserver", "CSS @keyframes", "requestAnimationFrame"],
    "reduced_motion": "respected"
  },
  "notes": "Brand chrome is warm-neutral with ONE terracotta accent. The vivid purple/magenta/crimson/teal in the raw profile are syntax-highlight colors inside faux-code mockups, not UI colors — quarantined under color.roles.code-syntax. Muted text is ink at 0.5-0.6 alpha, not a separate gray. Display tracking converted px→em at its measured size. Pill radius normalized from raw 3.3e7px. Hierarchy is scale + opacity; weight is near-uniform 400."
}
