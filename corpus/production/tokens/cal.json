{
  "color": {
    "bg": "#f4f4f4",
    "surface": "#ffffff",
    "fg": "#111111",
    "muted": "#898989",
    "accent": "#242424",
    "roles": {
      "canvas": "#f4f4f4",
      "card": "#ffffff",
      "ink": "#111111",
      "ink-secondary": "#242424",
      "muted": "#898989",
      "hairline": "#e1e2e3",
      "border-strong": "#d3d3d3",
      "control-track": "#e0e0e0",
      "cta-bg": "linear-gradient(#292929 0%, #242424 100%)",
      "cta-fg": "#ffffff",
      "cta-bevel": "rgba(255,255,255,0.15)",
      "calendar-cell": "#e5e7eb",
      "calendar-cell-selected": "#374151",
      "event-chip": "#aa61f1"
    }
  },
  "type": {
    "families": ["Cal Sans (geometric grotesque, display)", "Inter / Matter (UI + body)", "Roboto Mono (numerals)"],
    "scale": ["0.875rem", "1rem", "1.125rem", "1.5rem", "3rem", "4rem"],
    "weights": [300, 400, 500, 600],
    "leading": [1.1, 1.3, 1.5],
    "tracking": { "display": "0em", "ui": "-0.0125em" },
    "responsive": { "display_desktop": "4rem", "display_mobile": "2.5rem", "body": "1rem" }
  },
  "space": {
    "base": "4px",
    "scale": ["4px", "8px", "10px", "12px", "16px", "24px", "32px", "48px", "80px", "96px"]
  },
  "radius": ["4px", "8px", "12px", "16px", "100px"],
  "shadow": [
    "0 0 0 1px rgba(34,42,53,0.08), 0 1px 5px -4px rgba(19,19,22,0.7), 0 4px 8px rgba(34,42,53,0.05)",
    "0 1px 5px -4px rgba(36,36,36,0.7), 0 4px 8px rgba(36,36,36,0.05)",
    "inset 0 2px 0 rgba(255,255,255,0.15)"
  ],
  "container": { "content": "1224px", "measure": "640px" },
  "breakpoints": [640, 810, 1024, 1200],
  "motion": {
    "durations": [],
    "easings": ["ease"],
    "triggers": ["scroll-progress", "in-view", "hover"],
    "techniques": [
      "scroll-progress-rotate",
      "counter-rotated-orbit-icons",
      "in-view-state-machine",
      "sticky-nav-surface-fade",
      "scroll-progress-translate-chip",
      "center-focus-opacity-row"
    ],
    "scroll_effects": [
      { "name": "nav-pill-materializes", "property": "background", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "orbit-ring-rotate", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "orbit-icon-counter-rotate", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "calendar-selection-walks", "property": "background", "trigger": "in-view", "safety": "production-safe" },
      { "name": "duration-chip-select", "property": "background", "trigger": "in-view", "safety": "production-safe" },
      { "name": "floating-chip-parallax", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "vignette-glow-scale", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "testimonial-center-focus", "property": "opacity", "trigger": "scroll-progress", "safety": "production-safe" }
    ],
    "stack": ["Framer", "IntersectionObserver", "requestAnimationFrame"],
    "reduced_motion": "not-respected"
  },
  "notes": "Normalized away: the 12px/sans-serif/#0000ee cluster that dominates the raw frequency ranking is the third-party testimonial widget (cdn.senja.io) rendering with near-default UA styles — it is not the page's body type or link color. Real body is 16px/24px; small text 14px/21px. borderColor in the raw profile mirrors color exactly (probe artifact), so hairline/border values were read from the shadow rings and the screenshots instead: #e1e2e3 hairline, #d3d3d3 for emphasized rules. Radii 29px / 6.94px / 2.77px are transform-scaled artifacts of the miniature app UI; the real ladder is 4/8/12/16 with 100px pills. No custom properties of the site's own exist (the 52 detected are Tailwind-preflight and Framer internals), and no CSS durations/easings are declared — all timing lives in the JS runtime, so `durations` is honestly empty rather than guessed. `craft.theme.supportsDark` is false and the probe's `dark` block is just the light palette resampled, so no `color.dark` is emitted. Only saturated colors on the page belong to third-party logos, review-star widgets, and the embedded app's event chips."
}
