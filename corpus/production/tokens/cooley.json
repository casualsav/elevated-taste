    "fg": "#33040e",
    "muted": "#33040e",
    "accent": "#fd1434",
    "roles": {
      "ink": "#33040e",
      "accent-display": "#fd1434",
      "accent-text-aa": "#de0220",
      "tint": "#fff2f4",
      "tone-dark-bg": "#33040e",
      "tone-mid-bg": "#fd1434",
      "tone-light-bg": "#fff2f4",
      "fg-on-dark": "#fd1434",
      "fg-on-accent": "#33040e",
      "fg-on-accent-alt": "#fff2f4",
      "hairline": "#fd1434",
      "focus-ring": "#fd1434",
      "header-glass": "rgba(255,255,255,0.8)",
      "alt-theme-accent": "#5a46ff",
      "alt-theme-ink": "#05046e",
      "alt-theme-tint": "#e6eaff"
    }
  },
  "type": {
    "families": [
      "GT Sectra (display serif — headings, link titles)",
      "Arial Nova (sans — body, eyebrows, meta, buttons)",
      "Garamond, Times New Roman (serif fallback)",
      "Arial, Helvetica (sans fallback)"
    ],
    "scale": ["0.75rem", "0.875rem", "1rem", "1.25rem", "1.5rem", "1.75rem", "2.25rem", "3rem", "3.75rem", "5.75rem", "8.75rem"],
    "fluid": {
      "display": "clamp(4.25rem, 8.5vw, 8.75rem)",
      "h2": "clamp(3.375rem, 6.75vw, 5.75rem)",
      "h3": "clamp(2.625rem, 5.25vw, 3.75rem)",
      "h4": "clamp(2rem, 4vw, 3rem)",
      "h5": "clamp(1.5rem, 3vw, 2.25rem)",
      "body-lead": "clamp(1.25rem, 2.5vw, 1.5rem)"
    },
    "weights": [300, 400, 700],
    "leading": [0.9, 1.0, 1.1, 1.2, 1.3, 1.4],
    "tracking": {
      "display": "-0.01em",
      "body": "0.02em",
      "caption": "0.03em",
      "word-spacing-headings": "-0.05em"
    }
  },
  "space": {
    "base": "0.25rem",
    "scale": ["0.125rem", "0.25rem", "0.5rem", "0.75rem", "1rem", "1.5rem", "2rem", "3rem", "4rem", "6rem", "8rem", "16rem"],
    "fluid_pairs": {
      "xxs-to-sm": "clamp(0.5rem, 1vw, 1rem)",
      "sm-to-md": "clamp(1rem, 2vw, 1.5rem)",
      "md-to-lg": "clamp(1.5rem, 3vw, 2rem)",
      "lg-to-xxl": "clamp(2rem, 4vw, 4rem)",
      "section": "clamp(4rem, 10vw, 8rem)"
    },
    "grid": {
      "columns": { "mobile": 4, "desktop": 12 },
      "gutter": { "mobile": "1rem", "desktop": "2rem" },
      "live_area_cap": "1920px",
      "prose_measure": "720px"
    }
  },
  "radius": ["0", "2px", "3px", "20px"],
  "shadow": [],
  "motion": {
    "durations": ["200ms", "330ms", "600ms", "800ms", "1000ms"],
    "easings": ["ease-in-out", "cubic-bezier(0.16, 1, 0.3, 1)"],
    "triggers": ["load", "in-view", "scroll-progress", "hover"],
    "techniques": [
      "no-preference-gated-reveal",
      "in-view-fade-rise",
      "blur-rise-entrance",
      "scroll-parallax-tile-collage",
      "scroll-exit-dissolve",
      "arrow-rotate-affordance",
      "sticky-blur-header"
    ],
    "scroll_effects": [
      { "name": "hero-tile-parallax", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "headline-drift", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "hero-exit-dissolve", "property": "opacity", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "header-glass-fade", "property": "background", "trigger": "in-view", "safety": "production-safe" },
      { "name": "stagger-fade-rise-unblur", "property": "transform", "trigger": "in-view", "safety": "production-safe" },
      { "name": "tile-image-brightness", "property": "filter", "trigger": "scroll-progress", "safety": "production-safe" }
    ],
    "stack": ["GSAP", "Locomotive Scroll (data-scroll)", "Swiper", "IntersectionObserver", "CSS @keyframes"],
    "reduced_motion": "respected"
  },
  "notes": "Normalized from raw/cooley.css :root (168 custom properties), corroborated against the screenshots and 11 scroll frames. (1) There is NO gray tier on this site — `muted` is the same maroon ink demoted by size/case/family, not a lighter color; the greys in the computed profile (#696969, #212121, #555) all belong to the OneTrust cookie widget. (2) `accent` #fd1434 measures 3.9:1 on white — the site ships #de0220 (5.1:1) as `--color-primary-red--accessible` for anything below 24px; both are recorded rather than collapsed. (3) `shadow` is genuinely empty: the five box-shadows in the profile are all third-party (cookie banner, search widget), and `craft.elevation.gradients` is []. Depth is color-blocking + one 2px `backdrop-filter` on the sticky header. (4) The type scale lists the clamp *maxima* (desktop) — every tier is fluid; the `fluid` block records the real declarations. (5) Radii 2/3px are real; 20px is the tag pill and 17px was a one-off, dropped. (6) The royal/navy/sky triad is a dormant `data-page-theme=\"blue\"` sub-brand, present in tokens and unused on the homepage. (7) Motion durations exclude one-off 300/400/700ms values from vendor CSS; 330ms is the house transition (98 uses). (8) Reduced motion is respected via an inverted `(prefers-reduced-motion: no-preference)` gate — there is no `reduce` block, and none is needed."
}
