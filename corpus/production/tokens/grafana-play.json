      "fg": "#ccccdc",
      "muted": "rgba(204,204,220,0.65)",
      "accent": "#6e9fff"
    }
  },
  "type": {
    "families": ["Inter", "Roboto Mono"],
    "scale": ["0.75rem", "0.875rem", "1rem", "1.125rem", "1.75rem"],
    "weights": [400, 500, 700],
    "leading": [1.14, 1.57]
