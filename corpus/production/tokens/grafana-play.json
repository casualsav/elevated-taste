    "0 1px 2px rgba(1,4,9,0.75)",
    "0 2px 5px rgba(0,0,0,0.2)",
    "0 4px 12px rgba(0,0,0,0.3)"
  ],
  "motion": {
    "durations": ["100ms", "200ms", "250ms", "300ms"],
    "easings": ["cubic-bezier(0.4, 0, 0.2, 1)", "ease"],
    "triggers": ["hover", "in-view", "scroll-progress"],
    "techniques": ["fixed-shell-scrolling-canvas", "two-ring-focus", "opacity-lift-hover", "in-view-panel-render"],
    "scroll_effects": [
