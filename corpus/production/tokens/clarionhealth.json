{
  "color": {
    "bg": "#fbfaf8",
    "surface": "#fdfcfb",
    "surface-2": "#f6f5ed",
    "fg": "#361700",
    "muted": "#71604e",
    "accent": "#a73524",
    "roles": {
      "ground-cream": "#fbfaf8",
      "ground-teal": "#072d35",
      "ground-brown": "#3c210c",
      "fg-on-dark": "#fbfaf8",
      "muted-on-dark": "#fff9",
      "hairline": "#e7e4da",
      "hairline-2": "#eeece3",
      "teal-mid": "#257787",
      "mint": "#c9edde",
      "rust": "#a73524"
    }
  },
  "type": {
    "families": ["Moderat Serif Trial (display serif)", "Geist (body/UI sans)"],
    "scale": ["0.8rem", "1rem", "1.25rem", "1.5rem", "1.75rem", "3rem", "3.5rem"],
    "weights": [400, 500],
    "leading": [1.1, 1.2, 1.4, 1.5],
    "tracking": ["-0.03em display", "-0.16px body"],
    "notes": "headings = serif @500 (reads light); body/UI/eyebrow = Geist sans @400; fluid h1 40px→~61.7px"
  },
  "space": {
    "base": "8px",
    "scale": ["8px", "16px", "20px", "24px", "40px", "48px", "96px", "100px", "160px", "200px"],
    "section": "6.25rem",
    "section-lg": "10rem",
    "gaps": ["8px", "20px", "40px"]
  },
  "radius": ["8px", "12px", "16px", "40px", "96px", "1000px"],
  "shadow": ["none"],
  "container": { "max": "87.5rem", "px": "1400px" },
  "motion": {
    "durations": ["200ms", "300ms", "350ms", "400ms", "44s", "60s", "100s"],
    "easings": ["ease", "cubic-bezier(0.165, 0.84, 0.44, 1)"],
    "triggers": ["scroll-progress", "in-view", "hover", "load"],
    "techniques": [
      "sticky-pin-horizontal-scroll-carousel",
      "css-infinite-edge-faded-marquee",
      "active-item-list-panel-swap",
      "photo-into-color-gradient-scrim",
      "pill-hover-reskin"
    ],
    "scroll_effects": [
      { "name": "implementation-carousel-pin", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "hero-logo-marquee", "property": "transform", "trigger": "load", "safety": "production-safe" },
      { "name": "integration-logo-marquee", "property": "transform", "trigger": "load", "safety": "production-safe" }
    ],
    "stack": ["GSAP", "GSAP ScrollTrigger", "Swiper", "Webflow IX2", "CSS @keyframes", "IntersectionObserver"],
    "reduced_motion": "respected"
  },
  "notes": "Warm near-monochrome: neutrals hue-shifted to cream, text is deep brown (#361700) not black, one rust accent. Three page grounds (cream/teal/brown) act as section dividers; zero box-shadows; gradients used only for photo scrims and marquee edge-fades. h1/h2 tokens declare a fallback stack ('Bpmf Zihi Kai Std') but the loaded/rendered display face is Moderat Serif Trial — screenshots corroborate the serif. Marquee durations (44–100s) are decorative loop speeds, not UI timings."
}
