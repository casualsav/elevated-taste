{
  "color": {
    "bg": "#ffffff",
    "surface": "#f8fafc",
    "surface-2": "#f8f6f6",
    "fg": "#181d26",
    "muted": "#040e20b0",
    "accent": "#254fad",
    "roles": {
      "text-heading": "#181d26",
      "text-body": "#333840",
      "text-secondary": "#040e20b0",
      "text-tertiary": "#000e263b",
      "link": "#1b61c9",
      "surface-inverse": "#181d26",
      "surface-hero-black": "#0a0a0a",
      "brand-vermilion": "#f85c0e",
      "brand-pink": "#ea4ecb",
      "brand-indigo": "#775cff",
      "brand-yellow": "#ffcd05",
      "brand-red": "#e33a3d",
      "spotlight-gradient": "radial-gradient(100% 107% at 0% 50%, #fcab7966, #fc9ab44d 17%, #fa91e040 38%, #c6a9f533 51%, #95befc1f 68%)",
      "cta-gradient": "linear-gradient(80deg, #ff00a8 0%, #7c37ef 52%)"
    }
  },
  "type": {
    "families": ["Haas Groot Disp (display)", "ATSeasonSans (body/UI, variable 100-900)", "SF Pro Text (product-mockup chrome)"],
    "scale": ["0.75rem", "0.875rem", "1.25rem", "1.5rem", "2rem", "3rem", "4rem", "6rem", "7.5rem"],
    "weights": [400, 500, 550, 650, 700, 900],
    "leading": [1.0, 1.3, 1.5],
    "tracking": { "display": "-0.02em", "label-caps": "0.02em" },
    "features": ["tabular-nums (product mockups)"]
  },
  "space": {
    "base": "8px",
    "scale": ["8px", "12px", "16px", "24px", "40px", "48px", "64px"]
  },
  "radius": ["4px", "8px", "12px", "16px", "999px"],
  "shadow": [
    "0px 0px 1px 0px #181d2652, 0px 0px 2px 0px #181d2614, 0px 1px 4px 0px #181d2614",
    "0px 0px 1px 0px #181d263d, 0px 4px 8px 0px #181d2614, 0px 18px 32px 0px #0000001a"
  ],
  "layout": {
    "content_max": "1344px",
    "marketing_max": "1536px",
    "section_inline_pad": "48px",
    "columns": [1, 2, 3, 5],
    "breakpoints": [600, 640, 768, 900, 1024, 1280, 1344, 1600, 1664]
  },
  "motion": {
    "durations": ["150ms", "200ms", "400ms", "700ms", "30000ms"],
    "easings": ["cubic-bezier(0.4, 0, 0.2, 1)", "ease-in", "ease-out", "cubic-bezier(0, 0, 0.2, 1)"],
    "stagger_delays": ["80ms", "160ms", "240ms", "320ms", "400ms"],
    "triggers": ["scroll-progress", "in-view", "hover", "load"],
    "techniques": ["pinned-hero-curtain-reveal", "scroll-progress-orbit", "sticky-heading-tabs", "in-view-fade-rise-stagger", "scripted-demo-playback", "word-blur-in"],
    "scroll_effects": [
      { "name": "hero-curtain-reveal", "property": "position/clip", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "integrations-orbit-rotate", "property": "transform", "trigger": "scroll-progress", "safety": "spectacle-only" },
      { "name": "logo-and-card-stagger", "property": "transform/opacity", "trigger": "in-view", "safety": "production-safe" }
    ],
    "stack": ["IntersectionObserver", "CSS @keyframes", "CSS scroll/sticky layering"],
    "reduced_motion": "respected"
  },
  "a11y": {
    "focus_visible": true,
    "img_alt_ratio": 0.96,
    "small_tap_targets": "81 / 232 interactive (dense nav + footer)",
    "reduced_motion": true
  },
  "notes": "Normalized from a 445-token system down to roles. Site inks are warm-neutral: heading #181d26, body #333840, secondary as alpha-black #040e20b0 (~rgba(4,14,32,.69)). Type scale rounded to the display+body tiers actually shown (12/14/20/24/32/48/64/96/120px); mid-scale one-offs (10.5, 11.3px UI text) dropped. Brand hues + spotlight/CTA gradients are real primitive tokens but appear only in mockups and the closing banner. supportsDark=false (dark sections are opaque #181d26/#0a0a0a slabs, not a re-theme) — color.dark omitted."
}
