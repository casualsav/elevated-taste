{
  "color": {
    "bg": "#f9f8f5",
    "surface": "#ffffff",
    "fg": "#1a1613",
    "muted": "#666666",
    "accent": "#42b5dc",
    "roles": {
      "bg-warm-stone": "#f9f8f5",
      "surface-raised": "#ffffff",
      "surface-stone": "#f3f0e9",
      "text-primary": "#1a1613",
      "text-secondary": "#666666",
      "text-tertiary": "#999999",
      "stroke-light": "#f8f6f2",
      "stroke-stone": "#d8d1c0",
      "accent-blue": "#42b5dc",
      "surface-blue": "#ddf3f9",
      "surface-blue-deep": "#c3eaf4",
      "accent-amber": "#f99c00",
      "ink-near-black": "#120c08"
    }
  },
  "type": {
    "families": ["dmSans (sans - body/UI)", "abcMarist (serif - display/headlines)", "dmMono (mono - micro-labels/stats)"],
    "scale": ["0.875rem", "1.0625rem", "1.25rem", "1.557rem", "3.645rem", "5.4rem"],
    "scale_px_note": "14, 17, 20, 25, 58, 86 - root is 62.5% so 1rem=10px; display is fluid clamp(5rem,12.69vw,6.4rem) -> ~8.65rem at desktop, ~50px mobile",
    "weights": [350, 400],
    "leading": [0.95, 1.05, 1.3, 1.5],
    "tracking": { "display": "-1.73px", "h2": "-0.58px", "subhead": "-0.2px", "label": "0.07-0.2px" }
  },
  "space": {
    "base": "8px",
    "scale": ["4px", "5px", "8px", "16px", "24px", "32px", "80px", "160px", "200px", "270px"],
    "note": "section vertical rhythm is huge (160-270px padding-block); intra-component gap clusters at 16/24/32px"
  },
  "radius": ["4px", "12px", "16px", "18px", "32px", "64px"],
  "shadow": [],
  "container": { "max": ["766px (prose/copy)", "1350px", "1440px (full bleed)"] },
  "gradient": {
    "hero-sky": "linear-gradient(180deg,#6dc8e4 0%,#c3eaf4 100%)",
    "page-warm-to-sky": "linear-gradient(#ffffff 0%,#f9f8f5 30%,#c3eaf4 100%)",
    "closing-amber": "warm amber -> stone wash on the closing CTA band"
  },
  "motion": {
    "durations": ["150ms", "200ms", "300ms", "500ms", "1000ms"],
    "easings": ["cubic-bezier(0.4,0,0.2,1)", "cubic-bezier(0,0,0.2,1)", "cubic-bezier(0.22,1,0.36,1)"],
    "triggers": ["scroll-progress", "in-view", "hover", "load"],
    "techniques": ["in-view-scale-rise", "scroll-progress-parallax", "scroll-progress-scale", "sticky-nav-pin", "in-view-fade-rise"],
    "scroll_effects": [
      { "name": "testimonial-card-scale-in", "property": "transform", "trigger": "in-view", "safety": "production-safe" },
      { "name": "testimonial-thumbnail-scale-2to1", "property": "transform", "trigger": "in-view", "safety": "production-safe" },
      { "name": "hero-video-scale-1.05to1", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "floating-notification-parallax", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "section-fade-rise", "property": "opacity+transform", "trigger": "in-view", "safety": "production-safe" },
      { "name": "stat-headline-pin-shrink", "property": "transform (scale 1->0.7)", "trigger": "in-view", "safety": "spectacle-only" }
    ],
    "stack": ["IntersectionObserver (6 observers, thresholds 0/0.1, rootMargin 200px)", "requestAnimationFrame scroll loop (~4953 calls)", "JS-driven transforms (no CSS keyframes)", "canvas US-map"],
    "reduced_motion": "not-respected"
  },
  "notes": "Root font-size is 62.5% (1rem=10px); the raw profile's 6.25px 'body' is reset/icon noise -- real body is 17px, small 14px. No box-shadows anywhere: elevation comes from gradients, hairline borders, and warm surface steps (stone-100/200/300). Two accent families -- a calm sky-blue (product/UI) and a single warm amber (closing band). Serif (abcMarist) is the display voice across all headlines; dmSans handles body + product UI; dmMono micro-labels. Heavy rAF/parallax with reduced-motion NOT gated."
}
