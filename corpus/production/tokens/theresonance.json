{
  "color": {
    "bg": "#090d14",
    "surface": "#0a0c11",
    "surface-2": "#1e2129",
    "fg": "#eceef2",
    "muted": "#8792a5",
    "subtle": "#c2cad8",
    "accent": "#4f8cff",
    "border": "rgba(255,255,255,0.10)",
    "hairline": "rgba(255,255,255,0.08)",
    "roles": {
      "accent-stroke": "#2888ff",
      "accent-bevel": "#a7caff",
      "accent-deep": "#2a5fd6",
      "card": "rgba(255,255,255,0.05)",
      "demo-text": "#f5f7fc",
      "success": "#2ec77a",
      "danger": "#ff5f57",
      "warning": "#febc2e",
      "gradient-horizon": "linear-gradient(180deg,#090d14 0%,#071127 21%,#02225f 45%,#004bbd 69%,#0068f0 80%,#4ca3ff 100%)"
    }
  },
  "type": {
    "families": ["ritual (display)", "Geist (body/UI)", "Geist Mono (product-demo chrome)"],
    "scale": ["0.75rem", "0.875rem", "1rem", "1.125rem", "1.25rem", "1.5rem", "3rem", "4.5rem"],
    "weights": [400, 500],
    "leading": [1.0, 1.5, 1.625],
    "tracking": { "display": "-0.03em", "body": "-0.03em to 0", "caps": "0.09em" }
  },
  "space": {
    "base": "4px",
    "scale": ["4px", "8px", "12px", "16px", "24px", "32px", "48px", "64px", "80px", "112px", "144px"]
  },
  "radius": ["4px", "6px", "8px", "12px", "16px", "18px", "clamp(1.5rem,3vw,2.5rem)", "9999px"],
  "shadow": [
    "0 4px 6px -1px rgba(0,0,0,0.10), 0 2px 4px -2px rgba(0,0,0,0.10)",
    "0 20px 25px -5px rgba(0,0,0,0.10), 0 8px 10px -6px rgba(0,0,0,0.10)",
    "inset 0 0 0 1px rgba(255,255,255,0.09), inset 0 1px 0 0 rgba(255,255,255,0.08), 0 8px 18px 0 rgba(0,0,0,0.24)",
    "acrylic-bevel: inset 0 8px 8px 0 rgba(255,255,255,0.25), inset 0 -8px 8px 0 rgba(0,0,0,0.25), inset 0 0 0 8px #a7caff",
    "viewport-matte: inset 0 0 0 4px #a7caff, 0 0 0 4px #2888ff, 0 0 0 100vmax #000"
  ],
  "motion": {
    "durations": ["150ms", "200ms", "320ms", "620ms", "700ms", "820ms", "44000ms"],
    "easings": ["cubic-bezier(0.4,0,0.2,1)", "cubic-bezier(0.16,1,0.3,1)"],
    "triggers": ["load", "in-view", "hover", "scroll-progress"],
    "techniques": ["fixed-viewport-bezel", "logo-to-frame-morph", "in-view-reveal-up-stagger", "self-playing-dom-demo", "masked-logo-marquee", "glass-pinned-header"],
    "scroll_effects": [
      { "name": "viewport-bezel-pin", "property": "transform", "trigger": "load", "safety": "production-safe" },
      { "name": "glass-header-pin", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "reveal-up-in-view", "property": "opacity/transform", "trigger": "in-view", "safety": "production-safe" },
      { "name": "demo-clip-reveal", "property": "clip", "trigger": "in-view", "safety": "production-safe" },
      { "name": "demo-action-color-sequence", "property": "color", "trigger": "in-view", "safety": "production-safe" }
    ],
    "stack": ["IntersectionObserver", "CSS @keyframes", "requestAnimationFrame", "CSS transitions"],
    "reduced_motion": "respected"
  },
  "notes": "Dark-only site (theme.supportsDark=false) — no light/dark re-theme, so no color.dark axis; the palette above IS the (dark) design. lab()/oklab() computed values converted to approx hex/rgb: fg lab(94.76)→#eceef2, brand lab(63.26 -.98 -55.25)→#4f8cff, bg from theme-color meta #090D14. Type scale collapses the noisy fluid-computed px (63.99/69.99px etc.) to the rem stops in --text-*; display=4.5rem/7xl. Semantic colors (success/danger/warning) live inside the product-demo UI, not the marketing surfaces. Marquee 44s and the 100vmax matte spread are pattern-specific, not house values."
}
