{
  "color": {
    "bg": "#f4f4f0",
    "surface": "#ffffff",
    "fg": "#1c1a16",
    "muted": "#8c8880",
    "accent": "#732110",
    "roles": {
      "hairline": "#e6e6e4",
      "border": "#dbdad6",
      "grey": "#c8c4be",
      "limestone": "#d6cfbe",
      "oxblood-menu-bg": "#270802",
      "fg-on-image": "#ffffff",
      "muted-on-image": "rgba(255,255,255,0.6)",
      "artwork-terracotta": "#732110",
      "artwork-ember": "#ef4800",
      "artwork-sage": "#577662",
      "artwork-midnight": "#111b31"
    }
  },
  "type": {
    "families": ["martina (transitional serif, dlig ligatures) — display", "grotesk (neo-grotesque sans) — functional/body"],
    "scale": ["0.75rem", "0.875rem", "1rem", "1.5rem", "2rem", "2.5rem", "3rem", "3.75rem", "5rem"],
    "weights": [300, 400, 500],
    "leading": [1.0, 1.2, 1.25, 1.5, 1.625]
  },
  "space": {
    "base": "4px",
    "scale": ["4px", "8px", "12px", "20px", "40px", "80px", "200px", "240px"]
  },
  "radius": ["2px"],
  "shadow": [
    "0 1px 2px rgba(28,26,22,0.35), 0 0 1px rgba(28,26,22,0.2)",
    "0 2px 3px -1px rgba(28,26,22,0.32), 0 12px 24px -6px rgba(28,26,22,0.26)"
  ],
  "motion": {
    "durations": ["150ms", "300ms", "600ms"],
    "easings": ["ease", "cubic-bezier(0.4, 0, 0.2, 1)"],
    "triggers": ["scroll-progress", "in-view", "load", "hover"],
    "techniques": ["pinned-scrub-list-focus", "in-view-fade-rise", "parallax-drift", "staggered-load-reveal", "ambient-opacity-loop"],
    "scroll_effects": [
      { "name": "pinned-scrub-active-row", "property": "color", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "reveal-group-stagger", "property": "transform", "trigger": "in-view", "safety": "production-safe" },
      { "name": "reveal-group-fade", "property": "opacity", "trigger": "in-view", "safety": "production-safe" },
      { "name": "fullbleed-photo-parallax", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "paired-artwork-swap", "property": "opacity", "trigger": "scroll-progress", "safety": "production-safe" }
    ],
    "stack": ["IntersectionObserver", "CSS @keyframes", "position:sticky scroll-pin", "requestAnimationFrame", "scroll listeners"],
    "reduced_motion": "respected"
  },
  "notes": "Normalized from raw profile + CSS vars + screenshots. Weight collapsed to 300/400/500 — the page is overwhelmingly 400; 600 is defined but effectively unused, so hierarchy is register+scale, not weight. Scale maps the site's --text-size-* desktop vars (16/24/32/40/48/60/80) to rem. Accent (#732110 terracotta) and the other saturated hues are IMAGERY-ONLY — they never appear as UI fill/chrome; recorded here as roles for fidelity, not as an accent to apply to buttons. radiant-* token family (a secondary product-UI palette in the bundle) dropped as out-of-scope for the landing read. Section-gap scale (200/240px) is the signature spacing move. No dark theme (supportsDark:false) — color.dark omitted. Shadow is a single faint card elevation; the design is essentially shadowless."
}
