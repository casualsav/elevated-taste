{
  "color": {
    "bg": "#121212",
    "surface": "#313131",
    "surface-strong": "#454748",
    "fg": "#ffffff",
    "muted": "#8e8e8e",
    "accent": "#ae9a29",
    "roles": {
      "paper": "#121212",
      "paper-muted": "#ebebeb",
      "ink": "#ffffff",
      "ink-invert": "#121212",
      "accent-deep": "#38360d",
      "accent-foreground": "#ffffff",
      "muted-raised": "#b0b0b0",
      "neutral": "#737373",
      "line": "#313131",
      "line-soft": "rgba(115,115,115,0.2)",
      "line-light": "#e3e3e3",
      "light-section-bg": "#ffffff",
      "capture-weak": "#c64237",
      "capture-strong": "#dfa32f"
    }
  },
  "type": {
    "families": ["brandSans (variable 300-900, display/editorial)", "productSans (variable 100-900, body + product-UI)"],
    "scale": ["0.875rem", "1rem", "1.25rem", "2rem", "2.5rem", "2.75rem", "3rem", "3.5rem"],
    "scale_note": "Fluid: every size = calc(N * var(--u)) with --u = calc(100vw/1496). rem values are the 1496px base: caption 14, body/list-row 20, cta 16, person 32, item-title 40, statement 44, hero/section-head/quote 48, claim/team-head 56. Wordmark is compressed 900 at full-viewport width.",
    "weights": [400, 500, 700, 900],
    "leading": [0.9, 1.0, 1.15, 1.5],
    "tracking": "negative, size-linked: approx -2% on display (-0.62px@30 -> -1.08px@54)"
  },
  "space": {
    "base": "8px",
    "scale": ["2px", "4px", "6px", "8px", "12px", "16px"],
    "note": "8px for component gaps; layout distances expressed in --u (viewport-proportional)."
  },
  "radius": ["2px", "4px", "5px", "6px", "8px", "16px", "50%"],
  "shadow": ["inset 2px 0 0 0 #cdb84e, inset 0 0 0 1px rgba(205,184,78,0.28)"],
  "motion": {
    "durations": ["160ms", "360ms", "550ms", "2000ms"],
    "easings": ["cubic-bezier(0.32,0.72,0,1)", "cubic-bezier(0.33,0,0.2,1)", "cubic-bezier(0.4,0,0.6,1)", "ease"],
    "triggers": ["scroll-progress", "in-view", "hover", "load"],
    "techniques": ["blend-difference-pinned-chrome", "cta-text-wash-hover", "in-view-fade-rise-per-word", "sticky-pin-scrollytelling", "scroll-progress-parallax", "curtain-reveal-footer"],
    "scroll_effects": [
      { "name": "blend-difference-chrome", "property": "background", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "word-by-word-headline-reveal", "property": "opacity", "trigger": "in-view", "safety": "production-safe" },
      { "name": "image-band-grow-in", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" },
      { "name": "sticky-stacked-sections", "property": "transform", "trigger": "scroll-progress", "safety": "spectacle-only" },
      { "name": "curtain-reveal-footer", "property": "position", "trigger": "scroll-progress", "safety": "spectacle-only" },
      { "name": "cta-gradient-wash", "property": "background", "trigger": "hover", "safety": "production-safe" }
    ],
    "stack": ["IntersectionObserver (5 obs / 15 targets, threshold 0.01, rootMargin 0 0 -12% 0)", "CSS @keyframes (339, vg-k* canvas demos)", "CSS @property --cfill", "mix-blend-difference layer", "position:sticky pins", "requestAnimationFrame (184, 18 canvases)"],
    "reduced_motion": "respected"
  },
  "notes": "Palette and fluid type lifted from the site's real custom properties (--paper/--ink/--accent/--fs-*/--u). craft.type_detail.fluid_type reported false but the --u-based --fs-* tokens are unambiguously fluid — trusted the tokens. Shadow is the CTA's inset accent ring (only box-shadow on the page). Dark palette omitted as a separate axis: the page is natively dark and does not re-theme to a distinct dark mode (light sections are design regions, not a theme)."
}
