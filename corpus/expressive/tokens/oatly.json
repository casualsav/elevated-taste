{
  "color": {
    "bg": "#ffffff",
    "surface": "#f6f6f6",
    "fg": "#222222",
    "muted": "#888888",
    "accent": "#fdcf85",
    "roles": {
      "cream": "#fffef6",
      "ink": "#222222",
      "amber": "#fdcf85",
      "pink": "#f8c8d8",
      "pink-light": "#fbcccc",
      "purple": "#a67eb1",
      "sky": "#98c5d3",
      "green": "#2c622c",
      "border": "#222222",
      "focus-glow": "rgba(152,197,211,0.69)"
    }
  },
  "type": {
    "families": ["\"Margo Pro\", \"Courier New\", monospace"],
    "scale": ["0.84rem", "0.94rem", "1rem", "1.13rem", "1.25rem", "1.56rem", "1.69rem", "2rem"],
    "weights": [400, 700, 900],
    "leading": [1.2, 1.3, 1.5],
    "case": ["sentence body", "UPPERCASE tracked labels", "hand-drawn display"]
  },
  "space": { "base": "4px", "scale": ["4px", "8px", "16px", "24px", "40px", "44px"] },
  "radius": ["0", "3px", "100px"],
  "shadow": ["2px 2px 0 0 #000", "inset 0 0 0 1px #000"],
  "border": "1px solid #222222",
  "motion": {
    "durations": ["300ms", "400ms"],
    "easings": ["ease", "ease-in-out"],
    "triggers": ["load", "in-view", "hover", "navigation"],
    "techniques": ["route-cover-transition", "header-slide-in", "in-view-counter-bounce", "disclosure"],
    "scroll_effects": [
      { "name": "route-cover-fill", "property": "transform|clip", "trigger": "navigation", "safety": "spectacle-only" },
      { "name": "header-slide-in", "property": "transform|opacity", "trigger": "load", "safety": "production-safe" },
      { "name": "counter-bar-bounce", "property": "transform", "trigger": "in-view", "safety": "production-safe" }
    ],
    "stack": ["CSS @keyframes", "IntersectionObserver"],
    "reduced_motion": "respected"
  },
  "notes": "Normalized from raw/oatly.json corroborated against screenshots (desktop frame is fully occluded by a pinned cookie modal; mobile frame + visible page edges supplied the real surface). px font sizes converted to rem at 16px base; one-off subpixel sizes (19.47, 22.95, 16.875px) dropped. Accent palette = flat tile-fill swatches (no gradients exist on the site). Shadow is a hard zero-blur offset, not a soft glow. 'muted' #888 inferred from a low-frequency gray used for disabled/secondary UI. The only probe-reported 'pins' were the cookie banner and a11y skip-links — excluded as chrome, not design motion."
}
