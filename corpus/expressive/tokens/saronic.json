{
  "color": {
    "bg": "#162029",
    "surface": "#1B2733",
    "fg": "#F2F6FA",
    "muted": "#79848F",
    "accent": "#ACFF24",
    "roles": {
      "bg-deep": "#0F161C",
      "surface-2": "#44505C",
      "fg-on-dark": "#F2F6FA",
      "fg-on-light": "#162029",
      "light-bg": "#F2F6FA",
      "border-faint-on-dark": "rgba(242,246,250,0.2)",
      "border-faint-on-light": "rgba(22,32,41,0.1)",
      "muted-light": "#C6CBD0",
      "muted-cool": "#B0B9C6",
      "accent-action": "#ACFF24",
      "accent-marker": "#FB6B3C",
      "disabled-opacity": "0.33"
    }
  },
  "type": {
    "families": ["Suisse Int'l", "Suisse Mono", "ui-monospace"],
    "scale": ["0.75rem", "0.96rem", "1rem", "1.13rem", "1.38rem", "1.76rem", "2.19rem", "3.37rem", "14.12rem"],
    "weights": [400, 450],
    "leading": [1.1, 1.12, 1.25, 1.5],
    "tracking": ["-0.02em@28px", "-0.04em@54px", "-0.04em@226px"],
    "features": ["slashed-zero"],
    "roles": {
      "wordmark": "14.12rem / 400 / -0.04em",
      "section-head": "3.37rem / 400 / -0.02em",
      "body": "1rem / 400 / 1.5",
      "mono-label": "0.75rem / 450 / uppercase / tracked / Suisse Mono"
    }
  },
  "space": {
    "base": "8px",
    "scale": ["4px", "8px", "16px", "24px", "40px", "80px", "120px"]
  },
  "radius": ["2px", "4px", "100%"],
  "shadow": [
    "0 0 0 4px #162029, 0 0 0 5px #F2F6FA",
    "0 0 5px 0 rgba(128,128,128,1)"
  ],
  "motion": {
    "durations": ["250ms", "300ms", "500ms", "1000ms", "1100ms", "1200ms"],
    "easings": ["ease", "cubic-bezier(0.25, 0.25, 0, 1)"],
    "triggers": ["scroll-progress", "in-view", "hover", "load"],
    "techniques": [
      "inverting-sticky-header",
      "pinned-video-bg-opacity-fade",
      "tabbed-auto-advance-switcher",
      "footer-reveal-from-under",
      "micro-scale-hover"
    ],
    "scroll_effects": [
      { "name": "header-color-invert", "property": "color", "trigger": "in-view", "safety": "production-safe" },
      { "name": "header-bg-invert", "property": "background", "trigger": "in-view", "safety": "production-safe" },
      { "name": "hero-video-fade", "property": "opacity", "trigger": "scroll-progress", "safety": "spectacle-only" },
      { "name": "hero-video-pin", "property": "transform", "trigger": "scroll-progress", "safety": "spectacle-only" },
      { "name": "footer-reveal", "property": "transform", "trigger": "scroll-progress", "safety": "production-safe" }
    ],
    "stagger_delays_ms": [100, 250, 300, 400, 500],
    "stack": ["IntersectionObserver", "CSS @keyframes", "CSS transitions", "requestAnimationFrame", "HTML video"],
    "reduced_motion": "not-respected"
  },
  "notes": "Raw pixel sizes (28.24/53.96/225.96px etc.) are fluid-clamp samples at 1440px — normalized to a rounded rem scale; the 226px wordmark is a single hero element, not a reusable step. Palette collapsed from many near-duplicate rgb/oklab values to a slate+cool-white near-monochrome triad plus #ACFF24 action / #FB6B3C marker. Two weights only (400/450) — hierarchy is scale-driven, confirmed against screenshots. borderColor rgb(229,231,235) is a Tailwind-reset default (357 hits) and was dropped in favor of the observed faint slate/white hairlines. reduced_motion: site sets no prefers-reduced-motion rules (prmRules: 0) — flagged as a defect to fix when borrowing."
}
